# Copie para .env e ajuste. Nunca versione o ficheiro .env.
DATABASE_URL="postgresql://kianda:kianda@localhost:5432/kianda"

# API
API_PORT=4000
# Em produção: obrigatório, mínimo 32 caracteres (ex.: openssl rand -base64 48)
API_JWT_SECRET="mude-isto-para-um-segredo-longo-com-32-caracteres-ou-mais"
# Origem do frontend autorizada a enviar cookies (CORS)
WEB_ORIGIN="http://localhost:3000"

# Seed: palavra-passe do proprietário demo (admin@kwanzalog.co.ao)
SEED_OWNER_PASSWORD="Kianda2026demo"

# Web: endereço da API visto pelo servidor Next (proxy /api/* e componentes de servidor)
API_URL="http://localhost:4000"

# Copilotos (opcional). Sem chave, modelo e activação explícita, só funcionam os guias locais.
OPENAI_API_KEY=""
KIANDA_AI_MODEL=""
KIANDA_COPILOT_AI_ENABLED="false"
KIANDA_COPILOT_DAILY_LIMIT="100"
