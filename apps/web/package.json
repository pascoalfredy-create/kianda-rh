{
  "name": "@kianda/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/build-modeling-pdf.mjs && node ../../scripts/build-valuation-libs.mjs && next dev -p 3000",
    "build": "node ../../scripts/build-modeling-pdf.mjs && node ../../scripts/build-valuation-libs.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/build-modeling-pdf.mjs && node ../../scripts/build-valuation-libs.mjs && node ../../scripts/build-modeling-ui.mjs --check && node ../../scripts/build-valuation-ui.mjs --check && vitest run",
    "cf:build": "node ../../scripts/build-modeling-pdf.mjs && node ../../scripts/build-valuation-libs.mjs && opennextjs-cloudflare build",
    "cf:preview": "node ../../scripts/build-modeling-pdf.mjs && node ../../scripts/build-valuation-libs.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "modeling:generate": "node ../../scripts/build-modeling-ui.mjs",
    "valuation:generate": "node ../../scripts/build-valuation-ui.mjs"
  },
  "dependencies": {
    "@kianda/core": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "docx": "9.15.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "4.0.5"
  }
}
