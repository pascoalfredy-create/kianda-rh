{
  // Worker da API — sem endereço público (workers_dev: false, sem rotas). Só o Worker web lhe chega por service binding.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kianda-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Hyperdrive → PostgreSQL no Supabase. O id real é injectado no deploy (secret KIANDA_HYPERDRIVE_ID).
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "KIANDA_HYPERDRIVE_ID", "localConnectionString": "postgresql://kianda:kianda@localhost:5432/kianda" }
  ]
  // Secret (definido pelo deploy): API_JWT_SECRET
}
