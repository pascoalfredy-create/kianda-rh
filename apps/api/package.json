{
  "name": "@kianda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@kianda/core": "workspace:*",
    "@kianda/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": { "tsx": "4.23.15", "typescript": "5.9.3", "vitest": "4.0.5" }
}
